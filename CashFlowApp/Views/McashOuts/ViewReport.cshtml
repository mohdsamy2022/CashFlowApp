                <td>
@*                    <a asp-action="Edit" asp-route-id="@item.McashOutId">Edit</a> |
                    <a asp-action="Bar" asp-controller="BarChart" asp-route-id="@item.McashOutId">BarChart</a> |
                    <a asp-action="Delete" asp-route-id="@item.McashOutId">Delete</a>*@
