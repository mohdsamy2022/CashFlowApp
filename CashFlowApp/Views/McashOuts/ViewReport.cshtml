@model CashFlowApp.Models.ReportViewModel

@{
    ViewData["Title"] = "Index";
}




<h1>Index</h1>

<p>
    <div class="row">
@*        <div class="col-md-4">*@
            <form asp-action="ViewReport" class="form-inline">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-2">
                <label asp-for="MCashout.Year" class="control-label"></label>
                <select asp-for="MCashout.Year" class="form-control" asp-items="ViewBag.Year"></select>
                </div>
                <div class="form-group mx-sm-3 mb-2">
                <label asp-for="MCashout.ProjectId" class="control-label"></label>
                <select asp-for="MCashout.ProjectId" class="form-control" asp-items="ViewBag.ProjectId"></select>
                </div>
                <div class="form-group mb-2">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
@*        </div>*@
    </div>

</p>
