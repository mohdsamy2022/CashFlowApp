@model CashFlowApp.Models.Projects
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
@*    <div class="row">*@
@*        <div class="col-md-4">*@
            <form asp-action="Index">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
            <label asp-for="ProjectId" class="control-label"><h3>Select Project</h3></label>
                    <select asp-for="ProjectId" class="form-control" asp-items="ViewBag.ProjectId"></select>
                </div>
                <div class="form-group">
                    <input as type="submit" value="Select" class="btn btn-primary" />
@*                    <button type="button" onclick="location.href='@Url.Action("Save")'" />*@
                </div>
            </form>

    @if (ViewBag.Message != null && StaticProject.ProjectId>0)
    {
        <div class="alert alert-info">
            <h4>@ViewBag.Message</h4>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="card" style="width: 18rem;">
                    <img class="card-img-top" src="~/Images/daycashout.jpg" alt="Card image cap" style="height:218px; width:286px">
                    <div class="card-body">
                        <a href="#" class="btn btn-primary">المصروفات اليومية</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="width: 18rem;">
                    <img class="card-img-top" src="~/Images/daycashin.jpg" alt="Card image cap" style="height:218px; width:286px">
                    <div class="card-body">
                        <a href="#" class="btn btn-primary">المقبوضات اليومية</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card" style="width: 18rem;">
                    <img class="card-img-top" src="~/Images/reports.jpg" alt="Card image cap" style="height:218px; width:286px">
                    <div class="card-body">
                        <a href="#" class="btn btn-primary">تقارير</a>
                    </div>
                </div>
            </div>
        </div>
    }
@*        </div>*@
@*    </div>*@
@*    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>*@
</div>
